# Salin ke .env lalu sesuaikan. Jangan commit .env.
DATABASE_URL=postgresql+psycopg://perpustakaan:perpustakaan@127.0.0.1:5434/perpustakaan
# Wajib berakhiran _test; pytest menolak berjalan bila tidak.
DATABASE_URL_TEST=postgresql+psycopg://perpustakaan:perpustakaan@127.0.0.1:5434/perpustakaan_test

# dev | staging | production. Server produksi WAJIB production (data uji ditolak di sana).
APP_ENV=dev

# Akun admin awal untuk `uv run python -m app.seed admin` (FR-AKN-12). Isi hanya di .env lokal/server.
ADMIN_AWAL_NAMA=
ADMIN_AWAL_EMAIL=
ADMIN_AWAL_PASSWORD=

# Password akun skenario QA untuk `seed skenario` / `seed reset` (dev/staging). Isi hanya di .env lokal/server.
SKENARIO_PASSWORD=

# Tempat simpan gambar cover/foto: lokal (bawaan; dev, CI) | supabase (server).
# Disk container (mis. FastAPI Cloud) hilang setiap deploy -> server WAJIB supabase.
# STORAGE_BACKEND=lokal
# Mode lokal: folder unggahan (default backend/storage). Jangan di-commit.
# STORAGE_DIR=/var/lib/perpustakaan/storage
# Mode supabase: bucket PRIVAT (batas 2 MB, image/jpeg + image/png). Kunci secret/service_role
# hanya di env server, jangan pernah ke frontend. Isi hanya di .env lokal/server.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=perpustakaan
