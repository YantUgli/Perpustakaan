# Salin ke .env.local. Jangan commit .env.local.

# Alamat backend FastAPI, hanya dipakai server Next.js (rewrites development dan fetch dari Server Component).
# Sengaja tanpa awalan NEXT_PUBLIC_: browser tidak pernah memanggil backend langsung (satu origin, decisions §B);
# browser selalu memakai path relatif /api/v1.
# Wajib di luar development; saat `npm run dev` kosong = http://127.0.0.1:8000.
API_INTERNAL_URL=http://127.0.0.1:8000
